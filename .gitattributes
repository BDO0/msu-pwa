# Normalize line endings on every platform: store LF, check out LF.
* text=auto eol=lf

# Windows batch files must keep CRLF to run reliably in cmd.exe.
*.bat text eol=crlf

# Binary assets — never attempt text conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.docx binary

# Vendored third-party code: exclude from GitHub language statistics.
js/html5-qrcode.min.js linguist-vendored
